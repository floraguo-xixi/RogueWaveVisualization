Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"CoefficientList", "[", 
    RowBox[{
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"z", "  ", "\[Epsilon]"}], "-", 
         RowBox[{"0.32", 
          RowBox[{"\[Epsilon]", "^", "3"}]}], "  ", "-", 
         RowBox[{"0.28", " ", 
          RowBox[{"\[Epsilon]", "^", "5"}]}], "+", 
         RowBox[{"0.063", " ", 
          RowBox[{"\[Epsilon]", "^", " ", "7"}]}]}], " ", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Epsilon]", ",", "0", ",", "10"}], "}"}]}], "]"}], ",", 
     "\[Epsilon]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"aa", "=", 
