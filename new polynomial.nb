         RowBox[{"aa", "[", 
          RowBox[{"[", "6", "]"}], "]"}], ",", 
         RowBox[{"aa", "[", 
          RowBox[{"[", "8", "]"}], "]"}]}], "}"}], ")"}], ",", "z"}], "]"}], "//",
     "FullSimplify"}]}], ";", 
  RowBox[{"s", " ", "=", " ", 
